generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  username    String   @unique
  displayName String
  bio         String?
  avatarUrl   String?
  githubUrl   String?
  twitterUrl  String?
  websiteUrl  String?
  role        String   @default("builder") // builder | engineer | ai_expert
  apiKey      String   @unique @default(uuid())
  isPublic    Boolean  @default(true)
  lastSeenAt  DateTime?
  currentApp  String?
  currentProject String?
  isLive      Boolean  @default(false)
  showPresence Boolean @default(true)
  trackingPaused Boolean @default(false)
  redactWindowTitles Boolean @default(true)
  excludedApps Json @default("[]")
  hiddenApps Json @default("[]")
  privateProjects Json @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions   Session[]
  dailyStats DailyStat[]
  proofs     ProofObject[]
  follows    Follow[]  @relation("follower")
  followers  Follow[]  @relation("following")

  @@index([username])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  appName      String
  windowTitle  String?
  projectName  String?
  startTime    DateTime
  endTime      DateTime?
  durationSecs Int       @default(0)
  source       String    @default("active_window")
  confidence   Float     @default(0.4)
  isActive     Boolean   @default(false)
  date         DateTime  @default(now()) @db.Date
  createdAt    DateTime  @default(now())
  proofId      String?
  proof        ProofObject? @relation(fields: [proofId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, createdAt])
  @@index([userId, source])
  @@index([proofId])
}

model DailyStat {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  totalSecs    Int      @default(0)
  topApp       String?
  appBreakdown Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model ProofObject {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  projectName    String?
  kind           String    @default("build_note")
  summary        String?
  note           String?
  repoUrl        String?
  pullRequestUrl String?
  deploymentUrl  String?
  demoUrl        String?
  screenshotUrl  String?
  changelogUrl   String?
  commitRange    String?
  shippedAt      DateTime  @default(now())
  isPublic       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]

  @@index([userId, shippedAt])
  @@index([isPublic, shippedAt])
}
